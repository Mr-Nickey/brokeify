# Brokeify v3.0 Standalone SQLite Music Server Environment Variables
PORT=3487
NODE_ENV=production

# Persistent SQLite database (/data/brokeify.db), cover cache (/data/covers), and config.json directory
BROKEIFY_DATA_DIR=/data

# Mounted local hard drive or NAS music directory watched by Chokidar
BROKEIFY_MUSIC_DIR=/music

# Optional Homelab Integrations (can also be configured in Web UI Settings)
SLSKD_URL=
SLSKD_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=

# ==============================================================================
# BROKEIFY STANDALONE DOCKER SERVER — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Server Network & Reverse Proxy (Nginx Proxy Manager / Cloudflare / Traefik)
PORT=3487
TRUST_PROXY=1
CORS_ORIGIN=*

# 2. Persistent Volume Paths (Inside Container)
DATA_DIR=/data
MUSIC_DIR=/music
STAGING_DIR=/music/_inbox
BROKEIFY_DATA_DIR=/data
BROKEIFY_MUSIC_DIR=/music

# 3. Authentication & Security Gate
# Leave JWT_SECRET blank to auto-generate and persist a 64-byte cryptographic secret in /data/.jwt_secret on first boot,
# or provide your own 64-char hex secret (`openssl rand -hex 32`) for stateless token verification across restarts.
JWT_SECRET=
ALLOW_SIGNUP=false
BROKEIFY_REQUIRE_LOGIN=true

# 4. Optional External Integrations & Acoustic Fingerprinting (Configure here or inside the Web UI Settings)
SLSKD_URL=http://slskd:5030
SLSKD_API_KEY=
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=
# Register a free non-commercial AcoustID key at https://acoustid.org/new-application
ACOUSTID_API_KEY=

# 5. Optional Filesystem Watcher Tuning (Set to true for SMB/NFS/Windows network shares)
CHOKIDAR_USEPOLLING=false


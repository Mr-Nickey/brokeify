{
  "id": "/",
  "name": "Brokeify — Self-Hosted & Car-Ready Music Player",
  "short_name": "Brokeify",
  "description": "Self-hosted music aggregator and offline car audio player for Jellyfin, Navidrome, Emby, and Plex with FLAC/MP3 loudness stabilization, seamless crossfade, and IndexedDB offline playlist vault.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#070a0f",
  "theme_color": "#070a0f",
  "dir": "ltr",
  "lang": "en-US",
  "categories": ["music", "entertainment", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Play Songs",
      "short_name": "Songs",
      "description": "Jump straight to all songs in your library",
      "url": "/?view=songs",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Liked Songs",
      "short_name": "Liked",
      "description": "Play your favorited songs",
      "url": "/?view=liked",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Car Driving Mode",
      "short_name": "Car Mode",
      "description": "Launch high-contrast 1-tap Car Driving Mode",
      "url": "/?view=carmode",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
